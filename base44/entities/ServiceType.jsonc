{
  "name": "ServiceType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "registration",
        "permit",
        "grant",
        "certificate",
        "training"
      ]
    },
    "description": {
      "type": "string"
    },
    "sla_days": {
      "type": "number"
    },
    "fee": {
      "type": "string"
    },
    "approver_role": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "category"
  ]
}